<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>me.rueegger.bootmate</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-2.0-only</project_license>
  <name>Boot Mate</name>
  <summary>Manage autostart entries</summary>
  <description>
    <p>
      Boot Mate provides a simple and intuitive interface to manage your
      system's autostart entries. You can view all autostart applications,
      edit their properties, add startup parameters, or remove them entirely.
    </p>
    <p>
      Perfect for managing which applications start automatically when you
      log in to your GNOME session.
    </p>
  </description>
  <launchable type="desktop-id">me.rueegger.bootmate.desktop</launchable>
  <provides>
    <binary>bootmate</binary>
  </provides>
  <url type="homepage">https://github.com/srueegger/bootmate</url>
  <url type="bugtracker">https://github.com/srueegger/bootmate/issues</url>
  <url type="vcs-browser">https://github.com/srueegger/bootmate</url>
  <developer id="me.rueegger">
    <name>Samuel Rüegger</name>
  </developer>
  <branding>
    <color type="primary" scheme_preference="light">#99c1f1</color>
    <color type="primary" scheme_preference="dark">#1a5fb4</color>
  </branding>
  <content_rating type="oars-1.1" />
  <releases>
    <release version="50.0" date="2026-03-21">
      <description>
        <p>Flatpak bugfixes</p>
        <ul>
          <li>Fix user autostart entries not showing in Flatpak sandbox</li>
          <li>Fix translations not loading in Flatpak</li>
        </ul>
      </description>
    </release>
    <release version="1.3.0" date="2026-02-21">
      <description>
        <p>Flatpak support and new app identity</p>
        <ul>
          <li>App ID changed to me.rueegger.bootmate for domain verification</li>
          <li>Full Flatpak support with proper sandbox permissions</li>
          <li>Host-aware paths for system autostart directories in Flatpak</li>
          <li>Updated AppStream metadata</li>
        </ul>
      </description>
    </release>
    <release version="1.2.0" date="2025-12-04">
      <description>
        <p>New features and improvements</p>
        <ul>
          <li>Add RPM Builds</li>
        </ul>
      </description>
    </release>
    <release version="1.1.0" date="2025-11-30">
      <description>
        <p>Improved compatibility and build system</p>
        <ul>
          <li>Lower GTK requirement to 4.12 for broader compatibility</li>
          <li>Requires libadwaita 1.5 (available in Ubuntu 24.04)</li>
          <li>Removed Snap packaging in favor of DEB packages</li>
          <li>Fixed GitHub Actions automated builds</li>
        </ul>
      </description>
    </release>
    <release version="1.0.0" date="2025-11-28">
      <description>
        <p>First stable release</p>
        <ul>
          <li>View all autostart entries from user and system directories</li>
          <li>Edit autostart entry commands and parameters</li>
          <li>Delete or disable autostart entries</li>
          <li>Add new autostart entries from installed applications or custom commands</li>
          <li>Multi-language support (English and German)</li>
          <li>Modern GNOME interface with libadwaita</li>
        </ul>
      </description>
    </release>
  </releases>
  <screenshots>
    <screenshot type="default">
      <caption>Main window showing autostart entries in light mode</caption>
      <image>https://raw.githubusercontent.com/srueegger/bootmate/main/screenshots/bootmate-light.png</image>
    </screenshot>
    <screenshot>
      <caption>Main window in dark mode</caption>
      <image>https://raw.githubusercontent.com/srueegger/bootmate/main/screenshots/bootmate-dark.png</image>
    </screenshot>
    <screenshot>
      <caption>Adding a new autostart entry in light mode</caption>
      <image>https://raw.githubusercontent.com/srueegger/bootmate/main/screenshots/bootmate-light-add.png</image>
    </screenshot>
    <screenshot>
      <caption>Adding a new autostart entry in dark mode</caption>
      <image>https://raw.githubusercontent.com/srueegger/bootmate/main/screenshots/bootmate-dark-add.png</image>
    </screenshot>
  </screenshots>
</component>
